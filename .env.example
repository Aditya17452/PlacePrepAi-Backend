# PlacePrep AI backend — environment template.
#
# Copy to `.env` for local development and fill in real values. `.env` is gitignored.
# NEVER commit real secrets. In production these are set as Vercel environment
# variables, per environment (production / preview).
#
# With ENV=production the app refuses to start if any of the values marked [required]
# is missing or unsafe — see core/config.py.

# ── Environment ───────────────────────────────────────────────────────────────
ENV=local                       # local | preview | production
LOG_LEVEL=INFO
SENTRY_DSN=

# ── Database ──────────────────────────────────────────────────────────────────
# [required] Supabase Postgres. Use the POOLER connection string in production
# (port 6543), not the direct one. Example:
#   postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_STATEMENT_TIMEOUT_MS=15000

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# [required in production] REST is preferred on serverless. For local dev you can
# instead set REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
SESSION_TTL_SEC=7200

# ── Auth ──────────────────────────────────────────────────────────────────────
# [required] At least 32 characters in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24
BCRYPT_ROUNDS=12
# [required in production] Comma-separated. Bootstrapped into the DB once on first
# startup; after that the database is authoritative and this list is ignored.
ADMIN_BOOTSTRAP_EMAILS=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origins only — a wildcard is rejected at startup.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Optional regex for Vercel preview deployments, e.g.
#   ^https://placeprepai-frontend-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
FRONTEND_URL=http://localhost:8080

# ── Groq / LLM ────────────────────────────────────────────────────────────────
# [required in production]
GROQ_API_KEY=
GROQ_API_KEY2=
# llama-3.3-70b-versatile is Enterprise-only on Groq as of 2026-11. These are the
# self-serve production models; override per task if you benchmark something better.
LLM_MODEL_QUESTION=openai/gpt-oss-120b
LLM_MODEL_GRADER=openai/gpt-oss-120b
LLM_MODEL_EXTRACTOR=openai/gpt-oss-120b
LLM_MODEL_EVALUATOR=openai/gpt-oss-120b
LLM_MODEL_CHEAP=openai/gpt-oss-20b
# Optional: only set if your key still has access to a Llama model.
LLM_MODEL_FALLBACK=
STT_MODEL=whisper-large-v3-turbo
LLM_MAX_CONCURRENCY=8

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Test keys (rzp_test_*) are rejected when ENV=production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [required when Razorpay is enabled] Tokens are granted only from the verified
# payment.captured webhook, so without this nobody ever gets what they paid for.
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
# [required in production] Server-side only. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_SNAPSHOT_BUCKET=proctoring-snapshots
SNAPSHOT_RETENTION_DAYS=14

# ── Candidate context ─────────────────────────────────────────────────────────
# Fine-grained PAT, public-repo read only. Raises the GitHub API limit from 60/hour
# per instance IP (shared by every user) to 5,000/hour.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SEC=86400

# ── Tokens / quota ────────────────────────────────────────────────────────────
TOKEN_CONSUME_AFTER_ANSWERS=3
TOKEN_CONSUME_AFTER_SEC=300
MAX_AUTO_RELEASES_PER_DAY=2
DEFAULT_COLLEGE_MONTHLY_ALLOWANCE=4
DEFAULT_DAILY_INTERVIEW_CAP=3
FREE_TIER_TOKENS=2

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Vercel Cron sends this as a bearer token; without it the cron endpoints refuse to run.
CRON_SECRET=
