{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py" }],
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 6 * * *" },
    { "path": "/api/cron/maintenance", "schedule": "17 3 * * *" }
  ]
}
